aw/workspace/openclaw/src/agents/pi-embedded-helpers.normalizetextforcomparison.test.ts\n/Users/tolga/.openclaw/workspace/zedigital-tech-repo/public/fonts/jetbrains-mono-variable.woff2\n/Users/tolga/.openclaw/workspace/openclaw-comparison.md","cwd":"/Users/tolga/.openclaw/workspace-deepseek"},"isError":false,"timestamp":1773004690804}}
