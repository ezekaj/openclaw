# Ignore everything outside .openclaw
/*
!/.openclaw/
!/.gitignore

# Other workspaces (have embedded git repos)
.openclaw/workspace-*/

# Embedded git repos in research
.openclaw/workspace/openclaw/research/**/.git/

# Build artifacts
.openclaw/workspace/openclaw/node_modules/
.openclaw/workspace/openclaw/dist/

# OS files
.DS_Store

# Temp/lock files
*.tmp
*.swp
*.lock
