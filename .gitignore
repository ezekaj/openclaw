# Ignore everything by default
/*

# Only track the openclaw workspace
!/.openclaw/
/.openclaw/*
!/.openclaw/workspace/
/.openclaw/workspace/*
!/.openclaw/workspace/openclaw/
!/.gitignore

# Inside workspace: ignore build/runtime artifacts
.openclaw/workspace/openclaw/node_modules/
.openclaw/workspace/openclaw/dist/
.openclaw/workspace/openclaw/.DS_Store
.openclaw/workspace/openclaw/.git/

# Database files
*.db
*.db-shm
*.db-wal

# Temporary files
*.tmp
*.swp
*.bak
